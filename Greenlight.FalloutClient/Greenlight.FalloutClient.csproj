<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A reference consumer of MeddlingIdiot.Greenlight.Sdk: a fallout trefoil sitting on the
    desktop. It glows green while everything passes, amber while a pull request wants you,
    and when a pipeline breaks the thing detonates - a flash, a fireball, and a mushroom
    cloud standing over a small red trefoil. A build under way makes all of it breathe.

    The point of it is what it does NOT have. No Azure DevOps client, no GitHub client, no
    token, no polling loop - it reads everything from the Greenlight already running on the
    machine, through the package. Everything here is either Avalonia drawing, the tray icon,
    or the twenty-odd lines that talk to the SDK.

    It references the SDK as a package, which is all an app of your own has to do:
      dotnet add package MeddlingIdiot.Greenlight.Sdk

    net10.0-windows because the click-through overlay and the work-area maths are Win32. The
    SDK itself is plain net8.0/net10.0.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Greenlight.FalloutClient</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MeddlingIdiot.ico</ApplicationIcon>
    <!-- Not a package. Fallout's Package target packs the whole solution. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <!-- The SDK and the updater, the same way your own app would take them. -->
  <ItemGroup>
    <PackageReference Include="MeddlingIdiot.Greenlight.Sdk" Version="1.2.0" />
    <PackageReference Include="MeddlingIdiot.Velopack" Version="1.2.1" />
  </ItemGroup>

  <!-- The mascot, for the tray icon and the executable. Same icon the other apps use. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
